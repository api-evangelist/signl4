          "name": "Trigger Inbound Webhook Alert",
          "request": {
            "name": "Trigger Inbound Webhook Alert",
            "description": {
              "content": "Trigger a SIGNL4 mobile alert by posting a payload containing Title and Message fields along with any optional X-S4 control parameters. Authentication is via the team or webhook secret embedded in the URL path. Supports application/json, application/x-www-form-urlencoded, and multipart/form-data content types.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "webhook",
                ":teamSecret"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "teamSecret",
                  "description": "(Required) Team or webhook secret that authorizes the alert."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "method": "POST",
            "auth": null,
