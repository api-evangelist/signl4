          "id": "3aea914e-c683-4949-9807-97c9c32405e3",
          "name": "Create Event",
          "request": {
            "name": "Create Event",
            "description": {
              "content": "Raise an event in SIGNL4 that will be turned into a mobile alert. Authentication uses the X-S4-Api-Key header carrying the team or webhook secret.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "events",
                ":webhookIdOrTeamId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "webhookIdOrTeamId",
                  "description": "(Required) Webhook ID or team ID receiving the event."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-S4-Api-Key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Title\": \"<string>\",\n  \"Message\": \"<string>\",\n  \"ExternalID\": \"<string>\",\n  \"Status\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
