          "request": {
            "name": "Create Event",
            "description": {
              "content": "Raise an event in SIGNL4 that will be turned into a mobile alert. Authentication uses the X-S4-Api-Key header carrying the team or webhook secret.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "events",
                ":webhookIdOrTeamId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "webhookIdOrTeamId",
                  "description": "(Required) Webhook ID or team ID receiving the event."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
