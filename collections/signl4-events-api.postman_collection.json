  "info": {
    "_postman_id": "8e9959a7-9346-458d-ab0c-6e75e348c431",
    "name": "SIGNL4 Webhook and REST Events API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "SIGNL4 mobile alerting platform endpoints. The inbound webhook accepts JSON, form-encoded, or multipart payloads with Title and Message fields plus optional X-S4 control parameters and triggers SIGNL4 mobile alerts. The REST API v2 lets clients raise events with an X-S4-Api-Key header. Authentication uses a unique team or webhook secret embedded in the URL path or supplied via the API key header.\n\nContact Support:\n Name: SIGNL4 Support",
      "type": "text/plain"
    }
