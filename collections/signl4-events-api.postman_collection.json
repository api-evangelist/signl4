                  "key": "key",
                  "value": "X-S4-Api-Key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Title\": \"<string>\",\n  \"Message\": \"<string>\",\n  \"ExternalID\": \"<string>\",\n  \"Status\": \"<string>\"\n}",
